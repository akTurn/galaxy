import subprocess

from datetime import datetime, timezone

from core.models.observation import Observation


class ServiceCollector:

    def collect(self):

        observations = []

        result = subprocess.run(
            [
                "systemctl",
                "list-units",
                "--type=service",
                "--all",
                "--no-legend",
                "--no-pager",
            ],
            capture_output=True,
            text=True,
            check=False,
        )

        now = datetime.now(timezone.utc)

        for line in result.stdout.splitlines():

            parts = line.split(None, 4)

            if len(parts) < 4:
                continue

            unit = parts[0]
            load_state = parts[1]
            active_state = parts[2]
            sub_state = parts[3]

            if not unit.endswith(".service"):
                continue

            service_name = unit[:-8]

            observations.append(
                Observation(
                    source="systemd",
                    entity_type="service",
                    entity_id=f"service:{service_name}",
                    timestamp=now,
                    data={
                        "name": service_name,
                        "unit": unit,
                        "load_state": load_state,
                        "active_state": active_state,
                        "sub_state": sub_state,
                    },
                )
            )

        return observations
```

