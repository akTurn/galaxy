# 13D.9 Your NetworkGraph becomes

I would keep it approximately like this:

```python
class NetworkGraph:

    def __init__(self, store):
        self.store = store

    def get_relationships_from(
        self,
        entity_id,
        relationship_type=None,
    ):

        relationships = self.store.all_relationships()

        results = [
            relationship
            for relationship in relationships
            if relationship[1] == entity_id
        ]

        if relationship_type is not None:

            results = [
                relationship
                for relationship in results
                if relationship[2] == relationship_type
            ]

        return results

    def get_current_relationships(self):

        return self.store.current_relationships()

    def get_neighbors(
        self,
        entity_id,
        relationships=None,
    ):

        if relationships is None:
            relationships = self.store.all_relationships()

        neighbors = []

        for relationship in relationships:

            source_id = relationship[1]
            target_id = relationship[4]

            if source_id == entity_id:

                neighbors.append({
                    "direction": "out",
                    "relationship": relationship[2],
                    "entity_id": target_id,
                })

            elif target_id == entity_id:

                neighbors.append({
                    "direction": "in",
                    "relationship": relationship[2],
                    "entity_id": source_id,
                })

        return neighbors

    def get_current_neighbors(self, entity_id):

        relationships = self.store.current_relationships()

        return self.get_neighbors(
            entity_id,
            relationships,
        )

    def traverse(
        self,
        root_entity_id,
        max_depth=3,
    ):

        relationships = self.store.all_relationships()

        return self._traverse(
            root_entity_id,
            relationships,
            max_depth,
        )

    def traverse_current(
        self,
        root_entity_id,
        max_depth=3,
    ):

        relationships = self.store.current_relationships()

        return self._traverse(
            root_entity_id,
            relationships,
            max_depth,
        )

    def _traverse(
        self,
        root_entity_id,
        relationships,
        max_depth,
    ):

        visited = set()

        def walk(entity_id, depth):

            if depth > max_depth:
                return None

            if entity_id in visited:
                return None

            visited.add(entity_id)

            node = {
                "entity_id": entity_id,
                "neighbors": [],
            }

            for neighbor in self.get_neighbors(
                entity_id,
                relationships,
            ):

                child = walk(
                    neighbor["entity_id"],
                    depth + 1,
                )

                if child is not None:

                    node["neighbors"].append({
                        "relationship": neighbor["relationship"],
                        "direction": neighbor["direction"],
                        "node": child,
                    })

            return node

        return walk(root_entity_id, 0)
```

This is a nice architectural improvement because you don't duplicate traversal logic.

