import hashlib

import psutil
from datetime import datetime, timezone

from core.collectors.base import Collector
from core.models.observation import Observation


class ApplicationCollector(Collector):

    def collect(self) -> list[Observation]:

        applications = {}

        for process in psutil.process_iter(
            [
                "pid",
                "name",
                "exe",
                "cmdline",
            ]
        ):

            try:
                info = process.info

                pid = info.get("pid")
                name = info.get("name")
                executable = info.get("exe")
                cmdline = info.get("cmdline")

            except (
                psutil.NoSuchProcess,
                psutil.AccessDenied,
                psutil.ZombieProcess,
            ):
                continue

            # -----------------------------------------
            # Determine application identity
            # -----------------------------------------

            application_name = (
                executable
                or name
            )

            if not application_name:
                continue

            # Keep the application identity stable.
            identity = application_name

            application_id = hashlib.sha256(
                identity.encode("utf-8")
            ).hexdigest()[:16]

            entity_id = f"application:{application_id}"

            # -----------------------------------------
            # Group processes belonging to application
            # -----------------------------------------

            if entity_id not in applications:

                applications[entity_id] = {
                    "name": name,
                    "executable": executable,
                    "identity": identity,
                    "processes": [],
                }

            applications[entity_id]["processes"].append(pid)

        # ---------------------------------------------
        # Convert applications into observations
        # ---------------------------------------------
        
        timestamp = datetime.now(timezone.utc)

        observations = []

        for entity_id, data in applications.items():

            observations.append(
                Observation(
                    source="process",
                    entity_type="application",
                    entity_id=entity_id,
                    timestamp=timestamp,
                    data=data,
                )
            )

        return observations
